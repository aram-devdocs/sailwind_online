<Project>

  <!--
    Deploy a built BepInEx plugin into a LOCAL Thunderstore Mod Manager profile.

    Deployment is OPT-IN: it runs only when -p:Deploy=true is passed, so routine
    builds (make build, make validate, CI) never touch a play profile. `make
    deploy` and `make run-modded` set it.

    Target profile defaults to a DEDICATED "SailwindOnline" test profile, never
    the user's Default profile (which holds their own mod set). Override with
    -p:SailwindProfile=<path>. A csproj opts a project in by setting <PluginName>.
  -->

  <PropertyGroup>
    <SailwindProfile Condition="'$(SailwindProfile)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\Sailwind\profiles\SailwindOnline</SailwindProfile>
  </PropertyGroup>

  <Target Name="DeployToSailwindProfile"
          AfterTargets="Build"
          Condition="'$(Deploy)' == 'true' and '$(PluginName)' != '' and Exists('$(SailwindProfile)')">

    <PropertyGroup>
      <PluginDeployDir>$(SailwindProfile)\BepInEx\plugins\$(PluginName)</PluginDeployDir>
    </PropertyGroup>

    <ItemGroup>
      <DeployPayload Include="$(TargetPath)" />
      <DeployPayload Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>

    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="@(DeployPayload)"
          DestinationFolder="$(PluginDeployDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(PluginName) -> $(PluginDeployDir)" />
  </Target>

  <Target Name="WarnDeployProfileMissing"
          AfterTargets="Build"
          Condition="'$(Deploy)' == 'true' and '$(PluginName)' != '' and !Exists('$(SailwindProfile)')">
    <Message Importance="high" Text="Deploy requested but profile not found: $(SailwindProfile). Run scripts/setup-test-profile.ps1." />
  </Target>

</Project>
