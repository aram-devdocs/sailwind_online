#!/usr/bin/env bash
# Fast, deterministic pre-commit gate. Keep it quick: heavy build/test work
# belongs in pre-push (make validate) and CI, not here.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 1. Instruction-layer conventions: CLAUDE.md is a symlink to AGENTS.md, files are
#    under budget. (Replaces the old copy-parity check now that CLAUDE.md is a
#    symlink and cannot drift.)
bash scripts/check-conventions.sh

# 2. Leak guard: nothing proprietary may enter this public repo.
bash scripts/check-no-leak.sh

# 3. Game-IP guard: no game DLL, path, or decompiled source may ever be committed.
if [ -f scripts/guard-no-game-ip.sh ]; then
  bash scripts/guard-no-game-ip.sh
fi

exit 0
