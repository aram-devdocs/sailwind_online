<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Sailwind.API</AssemblyName>
    <RootNamespace>Sailwind.Api</RootNamespace>
    <!-- Drives build/Deploy.targets: the built plugin is copied into
         <profile>/BepInEx/plugins/Sailwind.API/ after Build. -->
    <PluginName>Sailwind.API</PluginName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Game + BepInEx + Unity references (with Assembly-CSharp publicized). Imported
       ONLY by engine-facing plugins; this is what keeps CI game-free. Requires lib/
       populated by scripts/setup-game.ps1, so this project is deferred until then. -->
  <Import Project="$(RepoRoot)build\GameReferences.props" />

  <ItemGroup>
    <!-- Sailwind.API is the shared host library; it ships the contracts DLL alongside
         itself so downstream plugins reference it Private=false with no skew. -->
    <ProjectReference Include="..\..\contracts\cs\Sailwind.Contracts\Sailwind.Contracts.csproj" Private="true" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build\Deploy.targets" />

</Project>
