<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sailwind Online — the MMO client BepInEx plugin (net472).
    Game-coupled: imports build/GameReferences.props (Unity + game DLLs from lib/)
    and build/Deploy.targets (copies the built plugin into the Thunderstore profile).
    This project CANNOT build in cloud CI (needs lib/ + a built Sailwind.API); it is
    intentionally absent from SailwindOnline.CI.slnf and builds only where lib/ exists.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Sailwind.Online.Client</AssemblyName>
    <RootNamespace>Sailwind.Online.Client</RootNamespace>
    <PluginName>SailwindOnline</PluginName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Reference assemblies so net472 compiles hermetically without a machine-wide targeting pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game / Unity / BepInEx references (Publicize on Assembly-CSharp); all Private=false. -->
  <Import Project="$(RepoRoot)build/GameReferences.props" />

  <!-- Networking: real LiteNetLib 1.3.1 (net471/netstandard2.0 line, Unity/Mono compatible).
       Private=true => ships beside the plugin. -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlatBuffers wire contracts; ships in the plugin folder. -->
    <ProjectReference Include="$(RepoRoot)contracts/cs/Sailwind.Contracts/Sailwind.Contracts.csproj" Private="true" />
    <!-- The mod-API layer ships as its own plugin (host ships shared libs once); do not copy it here. -->
    <ProjectReference Include="$(RepoRoot)src/Sailwind.API/Sailwind.API.csproj" Private="false" />
  </ItemGroup>

  <!-- Post-build deploy into the Thunderstore profile (uses <PluginName>). -->
  <Import Project="$(RepoRoot)build/Deploy.targets" />

</Project>
