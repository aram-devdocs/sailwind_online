<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Conformance harness and PoC test client. This is the interop authority for
    the Rust sw-net crate: it speaks the wire bytes of the REAL LiteNetLib 1.3.1
    client library, so if genuine LiteNetLib interoperates with sw-net, the game
    client will too. Pure net8.0 console, no game references.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Sailwind.ProtocolSmoke</AssemblyName>
    <RootNamespace>Sailwind.ProtocolSmoke</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <ProjectReference Include="..\..\contracts\cs\Sailwind.Contracts\Sailwind.Contracts.csproj" />
  </ItemGroup>

</Project>
