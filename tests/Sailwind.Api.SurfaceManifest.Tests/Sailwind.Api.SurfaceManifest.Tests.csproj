<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Sailwind.Api.SurfaceManifest.Tests</AssemblyName>
    <RootNamespace>Sailwind.Api.SurfaceManifest.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- References only the game-free API abstractions project and never loads the
         game assembly. It verifies committed manifest files, generated source
         literals, polled readiness behavior, and the otherwise inaccessible Unity
         composition-root wiring, so it runs in CI with no lib/ present. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\api-abstractions\Sailwind.Api.Abstractions\Sailwind.Api.Abstractions.csproj" />
  </ItemGroup>

</Project>
